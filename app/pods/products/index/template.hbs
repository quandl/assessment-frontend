<!-- TODO: Store this in it's own component -->
<div class="data-display">
  <h5 class="publisher-data-header">Datasets for {{publisher.title}}</h5>
  {{#each products as |product|}}
    <div class="data-display-wrapper">
      <div class="data-display-title">
        <h5 class="data-display-header">{{product.name}}</h5>
        <h5 class="data-display-expand">{{link-to 'EXPAND' 'products.show' product.id}}</h5>
      </div>

      <table WIDTH="100%" CELLPADDING="4" CELLSPACING="0">
        <!-- Displays the categories -->
        <tr class="data-row">
          {{#each product.categoriesSubset as |category|}}
            <td class="data-category">{{category}}</td>
          {{/each}}
        </tr>
        <!-- Displays the rows of data, as collected in route.js -->
        <!-- TODO: Find a way to do this with a component method -->
        {{#each product.productDataSubsetEntries as |product|}}
          {{#each product as |row|}}
            <tr class="data-row">
              {{#each row as |rowData|}}
                <td class="data-field">{{rowData}}</td>
              {{/each}}
            </tr>
          {{/each}}
        {{/each}}
      </table>

      <div class="data-display-footer">
        <p class="data-footer">SAMPLE ROWS</p>
      </div>
    </div>
  {{/each}}
</div>

