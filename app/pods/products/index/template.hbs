<header class="Header">
  <button title="menu" class="BurgerButton" {{action 'logger' 'BurgerButton'}}>
    <div class="BurgerButton__bar "></div>
    <div class="BurgerButton__bar "></div>
    <div class="BurgerButton__bar "></div>
  </button>
  <ul class="DataTabs ">
    <li class="DataTabs__list-item ">
      <a href=" # " class="DataTabs__tab" {{action 'logger' 'ALTERNATIVE DATA tab'}}>ALTERNATIVE DATA</a>
    </li>
    <li class="DataTabs__list-item ">
      <a href="# " class="DataTabs__tab DataTabs__tab--active " {{action 'logger' 'CORE FINANCIAL DATA tab'}}>CORE FINANCIAL DATA</a>
    </li>
  </ul>
  <img src='assets/quandl-logo.svg' class="Logo " alt="Quandl " />
  <ul class="UtilityNav ">
    <li class="UtilityNav__list-item ">
      <a href="# " class="UtilityNav__item " {{action 'logger' 'Docs & Help'}}>Docs & Help</a>
    </li>
    <li class="UtilityNav__list-item ">
      <a href="# " class="UtilityNav__item " {{action 'logger' 'Blog'}}>Blog</a>
    </li>
    <li class="UtilityNav__list-item ">
      <a href=" # " class="UtilityNav__item " {{action 'logger' 'Sign In'}}>Sign In</a>
    </li>
  </ul>
</header>
<main role="main ">
  <section class="Publisher ">
    <div class="Publisher__header ">
      <img src='assets/avatar.png' class="Publisher__avatar " alt=" {{publisher.title}} " />
      <h1 class="Publisher__title ">{{publisher.title}}</h1>
    </div>
    <div class="Publisher__datasets ">
      <h2 class="Publisher__datasets-title ">Datasets in this data product</h2>
      {{#each products as |product|}}
        <div class="Publisher__dataset ">
          <div class="Publisher__dataset-header ">
            {{product.name}}
            {{#link-to 'products.show' product.id class="Publisher__dataset-expand" }}EXPAND{{/link-to}}
          </div>
          <div class="DataSet DataSet--sample ">

            <table class="DataSet__table ">
              <tr class="DataSet__row DataSet__row--header ">
                <th class="DataSet__header ">m_ticker</th>
                <th class="DataSet__header ">ticker</th>
                <th class="DataSet__header ">comp_name</th>
                <th class="DataSet__header ">comp_name_2</th>
                <th class="DataSet__header ">exchange</th>
                <th class="DataSet__header ">currency_code</th>
                <th class="DataSet__header ">per_end_date</th>
                <th class="DataSet__header ">per_type</th>
                <th class="DataSet__header ">per_code</th>
                <th class="DataSet__header ">per_fisc_year</th>
                <th class="DataSet__header ">per_fisc_qtr</th>
                <th class="DataSet__header ">per_cal_year</th>
                <th class="DataSet__header ">per_cal_qtr</th>
                <th class="DataSet__header ">rev_type</th>
                <th class="DataSet__header ">rev_type_desc</th>
                <th class="DataSet__header ">broker_name</th>
                <th class="DataSet__header ">analyst_name</th>
                <th class="DataSet__header ">eps_rev_date</th>
                <th class="DataSet__header ">eps_rev_est</th>
              </tr>
              {{#each product.productDataSubset as |data|}}
                <tr class="DataSet__row ">
                  <td class="DataSet__cell ">{{data.m_ticker}}</td>
                  <td class="DataSet__cell ">{{data.ticker}}</td>
                  <td class="DataSet__cell ">{{data.comp_name}}</td>
                  <td class="DataSet__cell ">{{data.comp_name_2}}</td>
                  <td class="DataSet__cell ">{{data.exchange}}</td>
                  <td class="DataSet__cell ">{{data.currency_code}}</td>
                  <td class="DataSet__cell ">{{data.per_end_date}}</td>
                  <td class="DataSet__cell ">{{data.per_type}}</td>
                  <td class="DataSet__cell ">{{data.per_code}}</td>
                  <td class="DataSet__cell ">{{data.per_fisc_year}}</td>
                  <td class="DataSet__cell ">{{data.per_fisc_qtr}}</td>
                  <td class="DataSet__cell ">{{data.per_cal_year}}</td>
                  <td class="DataSet__cell ">{{data.per_cal_qtr}}</td>
                  <td class="DataSet__cell ">{{data.rev_type}}</td>
                  <td class="DataSet__cell ">{{data.rev_type_desc}}</td>
                  <td class="DataSet__cell ">{{data.broker_name}}</td>
                  <td class="DataSet__cell ">{{data.analyst_name}}</td>
                  <td class="DataSet__cell ">{{data.eps_rev_date}}</td>
                  <td class="DataSet__cell ">{{data.eps_rev_est}}</td>
                </tr>
              {{/each}}
            </table>
          </div>
          <div class="Publisher__dataset-legend ">Sample rows</div>
        </div>
      {{/each}}
    </div>
    <div class="Publisher__info ">
      <div class="Publisher__info-header ">Comercial Data</div>
      <h3 class="Publisher__info-title ">Data Overview</h3>
      <p class="Publisher__info-description ">
        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Laboriosam, dolor amet? Pariatur corporis nam commodi sequi quis
        perferendis ad, nisi officiis iusto labore vel exercitationem, officia neque dignissimos. Voluptate, vel.
      </p>
      <dl class="Publisher__details ">
        <dt class="Publisher__details-title ">Delivery Frequency
          <i class="InfoIcon "></i>
        </dt>
        <dd class="Publisher__details-desciption ">{{publisher.deliveryFrequency}}</dd>
      </dl>
      <dl class="Publisher__details ">
        <dt class="Publisher__details-title ">Data Frequency
          <i class="InfoIcon "></i>
        </dt>
        <dd class="Publisher__details-desciption ">{{publisher.dataFrequency}}</dd>
      </dl>
      <dl class="Publisher__details ">
        <dt class="Publisher__details-title ">Reporting Lag
          <i class="InfoIcon "></i>
        </dt>
        <dd class="Publisher__details-desciption ">{{publisher.reportingLag}}</dd>
      </dl>
      <dl class="Publisher__details ">
        <dt class="Publisher__details-title ">History
          <i class="InfoIcon "></i>
        </dt>
        <dd class="Publisher__details-desciption ">{{publisher.history}}</dd>
      </dl>
      <dl class="Publisher__details ">
        <dt class="Publisher__details-title ">Coverage
          <i class="InfoIcon "></i>
        </dt>
        <dd class="Publisher__details-desciption ">{{publisher.coverage}}</dd>
      </dl>
      <div class="Publisher__api ">
        Tables API
        <i class="InfoIcon "></i>
      </div>

      <button class="Publisher__pricing" {{action 'logger' 'pricing button'}}>Pricing</button>
    </div>

  </section>
</main>
{{!-- <h2>{{publisher.coverage}}</h2> --}}
