            <div class="middle slice"></div>
            <div class="slice"></div>
          </div>
        {{/link-to}}
      {{/click-log}}
      <div class="left-nav nav">
        <!-- TODO: Each of these can be in one component -->
        {{#click-log}}
          <a href="#" class="nav-item">ALTERNATIVE DATA</a>
        {{/click-log}}
        {{#click-log}}
          <a href="#" class="nav-item">CORE FINANCIAL DATA</a>
        {{/click-log}}
      </div>
      <img src='assets/quandl-logo.svg' class="logo">
      <div class="right-nav nav">
        {{#click-log}}
          <a href="#" class="nav-item">DOCS & HELP</a>
        {{/click-log}}
        {{#click-log}}
          <a href="#" class="nav-item">BLOG</a>
        {{/click-log}}
        {{#click-log}}
          <a href="#" class="nav-item">SIGN IN</a>
