<!-- COMPONENT 1 -->
<div class="nav-wrapper">
  <nav>
    <div class="links-bar">
      <!-- Displays the hamburger menu icon -->
      {{hamburger-icon}}

      <!-- Left items on nav bar -->
      <div class="left-nav nav">
        {{nav-tab text='ALTERNATIVE DATA'}}
        {{nav-tab text='CORE FINANCIAL DATA'}}
      </div>

      <img src='assets/quandl-logo.svg' class="logo">

      <!-- Right items on nav bar -->
      <div class="right-nav nav">
        {{nav-tab text='DOCS & HELP'}}
        {{nav-tab text='BLOG'}}
        {{nav-tab text='SIGN IN'}}
      </div>
    </div>

    <img src="/assets/avatar.png" alt="" class="avatar">
    <h3 class="publisher">{{publisher.title}}</h3>
  </nav>
</div>

<div class="data-display">
  <h5 class="publisher-data-header">Datasets for {{publisher.title}}</h5>
  {{#each products as |product|}}
    <div class="data-display-wrapper">

      <!-- Displays the table showing a sample of the available data -->
      {{sample-data-table product=product}}

      <!-- Display's the table's footer text -->
      {{footer-bar text='SAMPLE ROWS'}}
    </div>
  {{/each}}
</div>

<!-- This displays the overview of the data, on the right-hand side of the screen -->
<div class="data-overview">

  <div class="green-btn">COMMERCIAL DATA</div>

  <h5 class="data-overview-header">DATA OVERVIEW</h5>
  <p class="overview-text">Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis.</p>

  <!-- TODO: Each one of these can be made from one component
  specify text and dynamic info -->
  <div class="data-bullets">

    <div class="overview-bullet-wrapper">
      {{#click-log}}
        {{#link-to test}}
          <p href="#" class="bullet-name">DELIVERY FREQUENCY</p>
          <img src="/assets/info.png" class="i-icon" alt="">
          <h5 class="bullet-text">{{publisher.deliveryFrequency}}</h5>
        {{/link-to}}
      {{/click-log}}
    </div>

    <div class="overview-bullet-wrapper">
      {{#click-log}}
        {{#link-to test}}
          <p href="#" class="bullet-name">DATA FREQUENCY</p>
          <img src="/assets/info.png" class="i-icon" alt="">
          <h5 class="bullet-text">{{publisher.dataFrequency}}</h5>
        {{/link-to}}
      {{/click-log}}
    </div>
    <div class="overview-bullet-wrapper">
      {{#click-log}}
        {{#link-to test}}
          <p href="#" class="bullet-name">REPORTING LAG</p>
          <img src="/assets/info.png" class="i-icon" alt="">
          <h5 class="bullet-text">{{publisher.reportingLag}}</h5>
        {{/link-to}}
      {{/click-log}}
    </div>
    <div class="overview-bullet-wrapper">
      {{#click-log}}
        {{#link-to test}}
          <p href="#" class="bullet-name">HISTORY</p>
          <img src="/assets/info.png" class="i-icon" alt="">
          <h5 class="bullet-text">{{publisher.history}}</h5>
        {{/link-to}}
      {{/click-log}}
    </div>
    <div class="overview-bullet-wrapper">
      {{#click-log}}
        {{#link-to test}}
          <p href="#" class="bullet-name">COVERAGE</p>
          <img src="/assets/info.png" class="i-icon" alt="">
          <h5 class="bullet-text">{{publisher.coverage}}</h5>
        {{/link-to}}
      {{/click-log}}
    </div>
  </div>

  {{#click-log}}
    {{#link-to test}}
      <div class="tables-api-bar">
        <p href="#" class="tables-api-info">Tables API</p>
        <img src="/assets/info.png" class="i-icon i-icon-api" alt="">
      </div>
    {{/link-to}}
  {{/click-log}}

  {{#click-log}}
    <a href='#' class="blue-button">PRICING</a>
  {{/click-log}}
</div>

{{outlet}}
