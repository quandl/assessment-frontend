<!DOCTYPE html>

<head>
  <title>
    Quandl - Data Publisher
  </title>
  <link rel="stylesheet" type="text/css" href="/Quandl Mockup/app/styles/style.css">
  <link rel="stylesheet" type="text/css" href="assets/jquery-3.2.1.min.js">
</head>

  <!-- NAVIGATION BAR -->
  <div class="nav-bar">
    <div class="nav-bar-l">
      <a href="javascript:void(0)">
        <div id="hamburger">
          <div id="wrapper">
            <div class="line"></div>        
            <div class="line"></div>        
            <div class="line"></div>        
          </div>  
        </div>
      </a>
      <a href="javascript:void(0)" class="link-l">
        <div id="alt-data">
          Alternative Data
        </div>
      </a>
      <a href="javascript:void(0)" class="link-l selected">
        <div id="core-data">
          Core Financial Data
        </div>
      </a>

    </div>
    <div class="nav-bar-r">
      <a href="javascript:void(0)" class="link-r">Docs & Help</a>
      <a href="javascript:void(0)" class="link-r">Blog</a>
      <a href="javascript:void(0)" class="link-r">Sign In</a>
    </div>
    <div class="nav-bar-m">
      <a href="javascript:void()" class="logo"><img src="assets/quandl-logo.svg"></a>
    </div>
  </div>

  <!-- DATA TYPE BAR -->
  <div class="section-bar">
    <img src="assets/avatar.png" id="avatar">
    <span id="section-title">{{publisher.title}}</span>
  </div>

  <!-- BODY OF DATA AND OVERVIEW -->
  <div class="data-body">

    <!-- SAMPLE DATA -->
    <div class="dataset-box">
      <h4 id="dataset-desc">Datasets in this data product</h4>

      {{#each products as |product|}}
      <div id="dataset-wrapper">
        <div id="dataset-title">
          {{product.name}}
          {{link-to 'Expand' 'products.show' product.id class="exp"}}
        </div>
        <div class="data">
          <table>
            <tr>
              <th class="sample-header">m_ticker</th>
              <th class="sample-header">ticker</th>
              <th class="sample-header">comp_name</th>
              <th class="sample-header">comp_name_2</th>
              <th class="sample-header">exchange</th>
              <th class="sample-header">currency_code</th>
              <th class="sample-header">per_end_date</th>
              <th class="sample-header">per_type</th>
              <th class="sample-header">per_code</th>
              <th class="sample-header">per_fisc_year</th>
              <th class="sample-header">per_fisc_qtr</th>
              <th class="sample-header">per_cal_year</th>
              <th class="sample-header">per_cal_qtr</th>
              <th class="sample-header">rev_type</th>
              <th class="sample-header">rev_type_desc</th>
              <th class="sample-header">broker_name</th>
              <th class="sample-header">analyst_name</th>
              <th class="sample-header">eps_rev_date</th>
              <th class="sample-header">eps_rev_est</th>
              <th class="sample-header">eps_rev_date_prev</th>
              <th class="sample-header">eps_rev_est_prev</th>
            </tr>
            {{#each product.productDataSubset as |data|}}
              <tr>
                <td class="sample-data">{{data.m_ticker}}</td>
                <td class="sample-data">{{data.ticker}}</td>
                <td class="sample-data">{{data.comp_name}}</td>
                <td class="sample-data">{{data.comp_name_2}}</td>
                <td class="sample-data">{{data.exchange}}</td>
                <td class="sample-data">{{data.currency_code}}</td>
                <td class="sample-data per-end-date">{{data.per_end_date}}</td>
                <td class="sample-data">{{data.per_type}}</td>
                <td class="sample-data">{{data.per_code}}</td>
                <td class="sample-data">{{data.per_fisc_year}}</td>
                <td class="sample-data">{{data.per_fisc_qtr}}</td>
                <td class="sample-data">{{data.per_cal_year}}</td>
                <td class="sample-data">{{data.per_cal_qtr}}</td>
                <td class="sample-data">{{data.rev_type}}</td>
                <td class="sample-data">{{data.rev_type_desc}}</td>
                <td class="sample-data">{{data.broker_name}}</td>
                <td class="sample-data">{{data.analyst_name}}</td>
                <td class="sample-data eps-rev-date">{{data.eps_rev_date}}</td>
                <td class="sample-data">{{data.eps_rev_est}}</td>
                <td class="sample-data eps-rev-date-prev">{{data.eps_rev_date_prev}}</td>
                <td class="sample-data">{{data.eps_rev_est_prev}}</td>
              </tr>
            {{/each}}
          </table>
        </div>
        <div class="data-bot">
          Sample Rows
        </div>
      </div>
      {{/each}}

    </div>

    <!-- DATA OVERVIEW -->
    <div class="overview-box">
      <div id="data-type">Commercial Data</div>
      <h4 id="overview-title">Data Overview</h4>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis.
      </p>
      <div class="stats">
        <div>
          DELIVERY FREQUENCY
          <a href="javascript:void(0)" class="info-icon" title="Some info">i</a>
          <span class="del-freq details">{{publisher.deliveryFrequency}}</span>
        </div>
      </div>
      <div class="divider"></div>
      <div class="stats">
        <div>
          DATA FREQUENCY
          <a href="javascript:void(0)" class="info-icon" title="Some info">i</a>
          <span class="data-freq details">{{publisher.dataFrequency}}</span>
        </div>
      </div>
      <div class="divider"></div>
      <div class="stats">
        <div>
          REPORTING LAG
          <a href="javascript:void(0)" class="info-icon" title="Some info">i</a>
          <span class="rep-lag details">{{publisher.reportingLag}}</span>
        </div>
      </div>
      <div class="divider"></div>
      <div class="stats">
        <div>
          HISTORY
          <a href="javascript:void(0)" class="info-icon" title="Some info">i</a>
          <span class="hist details">{{publisher.history}}</span>
        </div>
      </div>
      <div class="divider"></div>
      <div class="stats">
        <div>
          COVERAGE
          <a href="javascript:void(0)" class="info-icon" title="Some info">i</a>
          <span class="details">
            <span class="coverage">{{publisher.coverage}}</span>
          </span>
        </div>
      </div>
      <div class="b-tables-api" id="b-tables-api">
        Tables API
        <span class="details">
          <a href="javascript:void(0)" class="info-icon" title="Some info">i</a>
        </span>
      </div>
      <a href="javascript:void(0)">
        <div class="b-pricing" id="b-pricing">
          Pricing
        </div>
      </a>
    </div>

  </div>
  <script type="text/javascript" src="assets/quandl.js"></script>