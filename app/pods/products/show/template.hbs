<div class="publisher-bar">
  {{#link-to 'products'}}
    <p class="arrow">&#60;</p>
    <img src="/assets/avatar.png" alt="" class="avatar">
    <h3 class="publisher publisher-show">{{publisher.title}}</h3>
  {{/link-to}}
</div>

<!-- TODO: Redesign the scroll function to match the mockup -->
<div class="table-display-window">
  <div class="publisher-data">
    <h4 class="product-name">{{product.name}}</h4>
    <div class="button-bar">
      {{#click-log}}
        {{#link-to test}}
          <div class="white-button">
            <h4 class="white-button-header">COVERAGE</h4>
          </div>
        {{/link-to}}
      {{/click-log}}
      {{#click-log}}
        {{#link-to test}}
          <div class="blue-button blue-button-show">
            <h4 class="blue-button-header blue-button-header-show">DOWNLOAD <span class="download-arrow">&#9660;</span></h4>
          </div>
        {{/link-to}}
      {{/click-log}}
    </div>
  </div>

  <div class="show-table-options">
    {{#click-log}}
      {{#link-to test}}
        <div class="table-option">
          <p class="table-option-text">DATA SAMPLE</p>
        </div>
      {{/link-to}}
    {{/click-log}}

    {{#click-log}}
      {{#link-to test}}
        <div class="table-option">
          <p class="table-option-text">COVERAGE</p>
        </div>
      {{/link-to}}
    {{/click-log}}
  </div>

  <div class="table-wrapper">
    <table class="show-table" WIDTH="100%" CELLPADDING="4" CELLSPACING="0">
      <!-- Displays the categories -->
      <tr class="data-row category-row-show">
        <td class="data-category data-cell-show"></td>
        {{#each product.categories as |category|}}
          <td class="data-category data-cell-show">{{category}}</td>
        {{/each}}
      </tr>
      <!-- Displays the rows of data, as collected in route.js -->
      {{#each product.productData as |product index|}}
        {{#each product as |row|}}
          <tr class="data-row">
            <td class="data-field data-cell-show">{{index}}</td>
            {{#each row as |rowData|}}
              <td class="data-field data-cell-show">{{rowData}}</td>
            {{/each}}
          </tr>
        {{/each}}
      {{/each}}
    </table>
  </div>
  <div class="data-display-footer">
    <p class="data-footer">SAMPLE ROWS</p>
  </div>
</div>

{{outlet}}
