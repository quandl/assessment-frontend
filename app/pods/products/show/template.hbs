<!-- COMPONENT 1 -->
<div class="publisher-bar">
  {{#link-to 'products'}}
    <p class="arrow">&#60;</p>
    <img src="/assets/avatar.png" alt="" class="avatar-show">
    <h3 class="publisher publisher-show">{{publisher.title}}</h3>
  {{/link-to}}
</div>

<!-- TODO: Redesign the scroll function to match the mockup -->
<div class="table-display-window">

  <!-- Renders the product header -->
  {{product-bar product=product}}

  <!-- Renders the bar with display options for the full table -->
  {{table-options-bar}}

  <!-- Renders the full table -->
  {{full-table product=product}}

  <!-- Display's the table's footer text -->
  {{footer-bar text='SAMPLE ROWS'}}
</div>
